credit:{h:()=>hd('Credit Risk','Customer climate scorecards sit alongside – never replace – the Bank’s approved obligor rating. Each score shows physical and transition sub-scores, drivers and a data-confidence grade.'),r:()=>{const R=BOR.map(b=>{const c=Math.round((b[3]+b[4])/2*(1-.3*b[5]/100));return{b,c,bd:band(c)[0]}});
return`${chips(['All',...bads],'f',S.f)}<div class="card"><h2>Customer climate scorecard</h2>${tb(['Borrower','Sector','District','#Physical','#Transition','#Resilience','#Composite','Band','Data confidence','Key drivers'],R.filter(x=>S.f=='All'||x.bd==S.f).map(x=>[x.b[0],x.b[1],x.b[2],x.b[3],x.b[4],x.b[5],`<b>${x.c}</b>`,pill(x.bd,band(x.c)[1]),pill(x.b[6],'nt'),x.b[7]]))}<p class="note">Composite = average of physical and transition inherent risk × (1 − 30% × resilience). Weights and thresholds are placeholders pending calibration with the Bank’s Risk, SME, Agriculture and Sustainability teams.</p></div>
<div class="two"><div class="card"><h2>Hazard to credit risk</h2><p>Flood exposure → asset damage or disruption → revenue and working-capital stress → weaker debt service → rating and PD indicators → ECL and stress-test impact.</p></div><div class="card"><h2>Sector concentration</h2>${tb(['Sector','#Exposure','Share'],SEC.map(s=>[s[0],f1(s[1]),bar(s[1]/1155*100*2.5)]))}</div></div>`}},
market:{h:()=>hd('Market Risk','Climate sensitivity of trading and investment books: rates, equities, FX and credit spreads under each scenario.')+ban('Scope to be confirmed with Risk Management – this view is a proposed design. '+ill),r:()=>{const[p,t]=SC[S.sc].map((v,i)=>v*HZ[S.h][i]),I=[['Government securities',1450,`Yield +${Math.round(120*p)} bps, duration 2.8`,-1450*2.8*.012*p],['Listed equities',60,`Equity −${f1(30*t+10*p)}%`,-60*(.3*t+.1*p)],['Net FX position',45,`PKR −${f1(8*p)}%`,-45*.08*p],['Corporate sukuk & bonds',90,`Spread +${Math.round(150*t+80*p)} bps, duration 3`,-90*3*(.015*t+.008*p)]],T=I.reduce((s,i)=>s+i[3],0);
return`${scs()}<div class="card"><div class="g">${kp('Portfolio exposure',f1(I.reduce((s,i)=>s+i[1],0))+' bn')}${kp('Climate P&L impact',neg(T)+' bn',S.sc+', '+S.h.split(' (')[0])}${kp('Impact on CET1',f1(T*(1-TAX)/RWA*100)+' pp','Post-tax')}</div></div><div class="card"><h2>Shock transmission</h2>${tb(['Book','#Exposure','Applied shock','#P&L (bn)'],I.map(i=>[i[0],f1(i[1]),i[2],neg(i[3])]))}</div>`}},
liquidity:{h:()=>hd('Liquidity Risk','Deposit-withdrawal stress for branches in high flood-hazard districts (PRLS), with the effect on the 30-day Liquidity Coverage Ratio.')+ban(ill)+`<div class="card"><h2>Assumption</h2>${sl('Deposit withdrawal rate','w',30)}</div>`,r:()=>{const a=HD*S.w/100,l0=lcr(0),l1=lcr(S.w);
return`<div class="card"><div class="g">${kp('Deposits in high flood-hazard districts',f1(HD)+' bn','30% of total deposits')}${kp('Added 30-day outflow',f1(a)+' bn',S.w+'% withdrawal')}${kp('LCR – baseline',f1(l0)+'%')}${kp('LCR – stressed',f1(l1)+'%',l1>=100?'Above 100% minimum':'Below minimum')}</div><div style="margin-top:14px">${bar(l1/1.5)}<p class="note">HQLA ${HQLA} bn ÷ net outflows (${OUT} + ${f1(a)}) bn. Needs required data and SBP methodology before regulatory use.</p></div></div><div class="card"><h2>Status</h2>${pill(l1>=130?'Comfortable':l1>=100?'Watch':'Breach',l1>=130?'ok':l1>=100?'wn':'er')}</div>`}},
oprisk:{h:()=>hd('Operational & Other Risks','Climate effects on the Bank’s own operations, plus reputational, compliance and environmental/social risks.')+ban(ill),r:()=>{const R=[['Branch & ATM flood exposure','Flood','112 of 900 branches in high-hazard districts','High','Branch network'],['Data centre heat and power','Extreme heat','Cooling load; backup power 72 h','Moderate','IT / Facilities'],['Business continuity','Compound hazards','BCP tested at 64% of critical sites','Moderate','Operations'],['E&S due diligence (ESRM)','Environmental/social','9 open escalation flags','High','Credit / Sustainability'],['Disclosure & greenwashing','IFRS S1/S2','Disclosure readiness 72%','Moderate','Sustainability / Compliance'],['Reputation & sector financing','Transition','Coal-linked exposure under review','High','Strategy / Risk']];
return`<div class="card"><div class="g">${kp('Branches in high-hazard districts','112','of 900')}${kp('BCP coverage','64%','Critical sites tested')}${kp('Open E&S flags','9','Awaiting review')}${kp('Disclosure readiness','72%','IFRS S1/S2')}</div></div><div class="card"><h2>Climate-related operational risk register</h2>${tb(['Risk','Climate driver','Indicator','Rating','Owner'],R.map(x=>[x[0],x[1],x[2],pill(x[3],x[3]=='High'?'er':'wn'),x[4]]))}</div>`}},
stress:{h:()=>hd('Stress Testing','Automates the Bank’s SBP-aligned climate stress tests (FSD Circular No. 01 of 2025) and feeds ICAAP. Shock variables map to the Bank’s own 2026 submission.')+ban('Zero-OS ingests the Bank’s methodology rather than imposing a generic model. Status below is a placeholder.'),r:()=>{const F=[['PRCS-1','Flood losses similar to 2022','Affected districts and exposures, prescribed shock logic','Parameters mapped'],['PRCS-2','Flood losses similar to 2025','2025 flood-affected geography and parameters','Awaiting parameters'],['PRCS-3','Vulnerable districts and sectors','District flood-hazard rank × sector vulnerability','Parameters mapped'],['PRCS-4','Sector-specific vulnerabilities','Sector vulnerability to borrower creditworthiness','Awaiting parameters'],['PRLS','Deposit withdrawals, high flood-hazard areas','Liquidity pressure on designated districts','Parameters mapped'],['Transition','Carbon tax','Emissions intensity × carbon price → interest coverage','Awaiting parameters']],C=calc(),x=cap(S.sc),O=[['Risk identification','Ready'],['Scenario design','Ready'],['Quantitative impact','In progress'],['Management response','Not started'],['Governance evidence','In progress']];
return`<div class="card"><h2>Scenario library</h2>${tb(['Family','Scenario','Platform treatment','Status'],F.map(f=>[`<b>${f[0]}</b>`,f[1],f[2],pill(f[3],f[3]=='Parameters mapped'?'ok':'wn')]))}</div>${scs()}<div class="card"><h2>Illustrative run: ${S.sc}, ${S.h}</h2><div class="g">${kp('Δ provisions',f1(C.d)+' bn')}${kp('CET1 after shock',f1(x.c)+'%')}${kp('CAR after shock',f1(x.a)+'%')}</div><div style="margin-top:14px">${sectorTbl()}</div></div><div class="card"><h2>ICAAP support outputs</h2>${tb(['Output','Status'],O.map(o=>[o[0],pill(o[1],o[1]=='Ready'?'ok':o[1]=='In progress'?'wn':'nt')]))}<p class="note">Horizons: short, medium and long term as agreed with the Bank.</p></div>`}},
ecl:{h:()=>hd('ECL – Climate Overlay','Sensitivity of PD, LGD and ECL to climate scenarios by sector. Analysis only: the Bank’s approved IFRS 9 models and production parameters are not changed.')+ban('Any production use follows the Bank’s model development, independent validation and approval procedures. '+ill)+`<div class="card"><h2>Assumption</h2>${sl('Climate overlay strength','k',100)}</div>`,r:()=>{const c=calc(),s2=12+c.d/c.base*100*.15;
return`${scs()}<div class="card"><div class="g">${kp('Base ECL',f1(c.base)+' bn')}${kp('Scenario ECL',f1(c.ecl)+' bn','+'+f1(c.d)+' bn')}${kp('ECL uplift',f1(c.d/c.base*100)+'%')}${kp('Stage 2 share',f1(s2)+'%','Base 12.0%')}</div></div><div class="card"><h2>ECL by sector</h2>${sectorTbl()}<p class="note">Scenario ECL = base ECL × (1 + overlay × (physical sensitivity × physical pressure + transition sensitivity × transition pressure)).</p></div>
<div class="card"></div>${mx('ECL uplift by scenario and horizon (%)',(s,z)=>'+'+f1(calc(s,z).d/calc(s,z).base*100))}<div class="card"><h2>Capabilities</h2><ul><li>PD sensitivity and LGD/collateral channel under physical scenarios</li><li>Baseline and adverse forward-looking scenarios with documented narratives and weights</li><li>Segmentation by sector, geography, product and collateral type</li><li>Model governance: assumptions, lineage, versions, validation evidence, overrides and approval logs</li></ul></div>`}}};
const NAV=[['home','Home','⌂'],['carbon','Carbon Accounting','▦',[['scn1','Scope 1 & 2'],['scope3','Scope 3 – Financed Emissions','Prototype']]],['risk','Risk & Governance','⚖',[['rgd','Dashboard'],['rgin','Governance'],['roin','Risks & Opportunities'],['cin','Climate Scenarios'],['rmin','Risk Mitigation'],['cla','Capital & Liquidity Adequacy',1],['credit','Credit Risk',1],['market','Market Risk',1],['liquidity','Liquidity Risk',1],['oprisk','Operational & Other Risks',1],['stress','Stress Testing',1],['ecl','ECL',1]]],['strategy','Strategy & Roadmap','➚',[['srp','Strategy Report']]],['capacity','Capacity Building','✎',[['cbo','Overview'],['cbt','Training Calendar'],['cbs','Self-Paced Learning']]],['reports','Reports','▤'],['settings','Settings','⚙'],['it','IT Support','☎'],['admin','Admin Support','☺']];
let cur='home',NAVOPEN={carbon:1,risk:1};
function nav(){$('nv').innerHTML=NAV.map(([id,l,ic,k])=>{const on=cur==id||(k&&k.some(x=>x[0]==cur)&&!NAVOPEN[id]);return`<div class="ni ${on?'on':''}" onclick="${k&&k.length?`NAVOPEN['${id}']=!NAVOPEN['${id}'];nav()`:`go('${id}')`}"><i>${ic}</i>${l}${k?`<span class="ch">${NAVOPEN[id]?'⌃':'⌄'}</span>`:''}</div>`+(k&&NAVOPEN[id]?k.map(x=>`<div class="kid ${cur==x[0]?'on':''}" onclick="go('${x[0]}')">${x[1]}${x[2]?'<span class="new">'+(x[2]===1?'Bank':x[2])+'</span>':''}</div>`).join(''):'')}).join('')}
function go(id){cur=id;history.replaceState(null,'','#'+id);nav();const p=P[id];$('m').innerHTML=p?p.h()+'<div id="res"></div>':hd((NAV.flatMap(x=>[x,...(x[3]||[])]).find(x=>x[0]==id)||[0,'Module'])[1],'Not included in this prototype.');upd();scrollTo(0,0)}
